
<head>
    <title>My Blog</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
     <div class="container">
    <header>
        <div>
        <h1>Welcome to My Blog</h1>
        <p>Thoughts, Stories & Ideas</p>
        </div>
        <a class="create-button" href="/create">Create a Post</a>
    </header>

<%posts.forEach((post, index) => { %>
    <div class="post">
        
        <h2><%=index+1%> <%= post.title %></h2>
        <p><%= post.introduction %></p>
        <a href="/post/<%= post.id %>">Read More</a>
        
        <a class="edit-button" href="/edit/<%= post.id %>">Edit</a>
        <form action="/delete/<%= post.id %>" method="POST" style="display:inline;">
            <button class="delete-button" type="submit" onclick="return confirm('Are you sure you want to delete this post?');">Delete</button>
        </form>
    </div>
<% }); %>
